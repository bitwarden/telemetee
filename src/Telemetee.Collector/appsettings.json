{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": true,
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*",
  "Attestation": {
    "SidecarUrl": "http://localhost:8080",
    "MaaEndpoint": "sharedeus2.eus2.attest.azure.net",
    "UseDevelopmentIssuer": false
  }
}
